#!/usr/bin/env python3
"""Control one peakminer miner. The panel's only privileged entry point.

The panel never builds a control command itself: it calls

    miner-control <start|stop|restart|status> <host> <unit>

and this script resolves the host, checks the unit against the fleet
definition, and runs the right control path:

  * k3s (the five Linux miners since 2026-09-21): kubectl scale /
    rollout restart on deployment <k8s.deploy> in namespace <k8s.ns>.
    Runtime control only — config lives in git (reverb256/mining-k8s) + ArgoCD.
  * systemd (rollback path, and any miner without a k8s mapping): systemctl
    locally or over ssh.
  * Windows NSSM (krash2): nssm over ssh.

Refusing an unknown host/unit pair keeps a bad panel binding from reaching
any control surface at all.
"""

from __future__ import annotations

import argparse
import http.client
import json
import os
import shutil
import ssl
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

from fleet import FLEET  # noqa: E402

ACTIONS = ("start", "stop", "restart", "status")
SSH_OPTIONS = ["-o", "BatchMode=yes", "-o", "ConnectTimeout=5"]
KUBECONFIG = str(Path.home() / ".kube" / "config")

# --- k8s API endpoint failover -------------------------------------------------
# The kubeconfig pins ONE apiserver (nexus on this host). During the 2026-09-24
# nexus-k3s outage every panel pause/start silently failed while the cluster
# itself stayed healthy on the other control-planes. After a connectivity-class
# failure, probe the peers in order and retry the action once against the first
# live one. Probe = "does anything answer TLS on 6443": the apiserver requires
# auth even for /readyz, so ANY HTTP response (401 included) proves it is up.
# Test override: MINER_K8S_ENDPOINTS="10.1.1.199:6443,10.1.1.100:6443"
K8S_API_CANDIDATES = (
    "10.1.1.100:6443",  # DNS_VIP - whichever control-plane holds it
    "10.1.1.140:6443",  # sentry
    "10.1.1.130:6443",  # forge
    "10.1.1.120:6443",  # nexus
)
K8S_PROBE_TIMEOUT = 2.0
UNREACHABLE_MARKERS = (
    "connection refused",
    "dial tcp",
    "i/o timeout",
    "context deadline exceeded",
    "unable to connect to the server",
    "no route to host",
    "connection reset by peer",
    "tls handshake timeout",
    "network is unreachable",
)


def k8s_api_alive(hostport, timeout=K8S_PROBE_TIMEOUT):
    """True when https://<hostport> answers at all (a 401 counts - it proves
    an apiserver is listening; a dead one refuses or times out)."""
    host, _, port = hostport.partition(":")
    connection = None
    try:
        connection = http.client.HTTPSConnection(
            host, int(port), timeout=timeout,
            context=ssl._create_unverified_context(),
        )
        connection.request("GET", "/readyz")
        connection.getresponse().read()
        return True
    except Exception:  # noqa: BLE001 - any failure means "endpoint dead"
        return False
    finally:
        if connection is not None:
            try:
                connection.close()
            except Exception:  # noqa: BLE001
                pass


def k8s_candidates():
    raw = os.environ.get("MINER_K8S_ENDPOINTS")
    if raw:
        return tuple(item.strip() for item in raw.split(",") if item.strip())
    return K8S_API_CANDIDATES


def endpoint_unreachable(stderr):
    text = (stderr or "").lower()
    return any(marker in text for marker in UNREACHABLE_MARKERS)


def run_k8s(command, env):
    """Run kubectl; if its pinned endpoint is unreachable, retry once via peers."""
    try:
        completed = subprocess.run(
            command, capture_output=True, text=True, timeout=30, check=False, env=env
        )
    except subprocess.TimeoutExpired:
        completed, reason = None, "kubectl timed out"
    else:
        if completed.returncode == 0 or not endpoint_unreachable(completed.stderr):
            return completed
        lines = (completed.stderr or "").strip().splitlines()
        reason = lines[-1] if lines else f"kubectl exit {completed.returncode}"

    for endpoint in k8s_candidates():
        if not k8s_api_alive(endpoint):
            continue
        print(f"miner-control: {reason} — retrying via {endpoint}", file=sys.stderr)
        retry = [command[0], "--server", f"https://{endpoint}", *command[1:]]
        return subprocess.run(
            retry, capture_output=True, text=True, timeout=30, check=False, env=env
        )
    if completed is not None:
        return completed
    raise subprocess.TimeoutExpired(command, 30)


def fail(message, code=1):
    print(json.dumps({"ok": False, "error": message}))
    sys.exit(code)


def find_miner(host, unit):
    config = FLEET.get(host)
    if not config:
        fail(f"Unknown host: {host}")
    for miner in config["miners"]:
        if miner["unit"] == unit:
            return config, miner
    fail(f"Unknown unit for {host}: {unit}")


def kubectl_bin():
    found = shutil.which("kubectl")
    if found:
        return found
    # mise-managed installs (the panel may run without shims on PATH)
    candidates = sorted(Path.home().glob(".local/share/mise/installs/kubectl/*/kubectl"))
    if candidates:
        return str(candidates[-1])
    for fallback in ("/usr/local/bin/kubectl", "/usr/bin/kubectl"):
        if os.path.exists(fallback):
            return fallback
    fail("kubectl not found — cannot control k3s-managed miners")


def build_k8s_command(k8s, action):
    deploy = k8s["deploy"]
    ns = k8s.get("ns", "mining")
    kubectl = kubectl_bin()
    if action == "status":
        # readyReplicas is "" when scaled to zero -> inactive (mirrors is-active)
        return [kubectl, "-n", ns, "get", "deploy", deploy,
                "-o", "jsonpath={.status.readyReplicas}"]
    if action == "restart":
        return [kubectl, "-n", ns, "rollout", "restart", f"deploy/{deploy}"]
    replicas = "1" if action == "start" else "0"
    return [kubectl, "-n", ns, "scale", f"deploy/{deploy}", f"--replicas={replicas}"]


def build_command(host, unit, action, miner):
    config = FLEET.get(host)

    k8s = miner.get("k8s")
    if k8s:
        return build_k8s_command(k8s, action), "k8s"

    # The Kryptex app rig is monitor-only: there is no unit behind the name,
    # so never let a stray panel binding reach a control command.
    if config.get("control") == "none":
        fail(f"{host} is monitor-only (Kryptex app) — nothing to control")

    is_windows = config.get("platform") == "windows"

    if is_windows:
        # Windows NSSM services: nssm <action> <service>
        if action == "status":
            remote = ["cmd", "/c", f"nssm status {unit}"]
        else:
            remote = ["cmd", "/c", f"nssm {action} {unit}"]
    else:
        if action == "status":
            remote = ["systemctl", "is-active", unit]
        else:
            remote = ["systemctl", action, unit]

    if config.get("local"):
        return remote, "systemd"
    # Remote hosts have no local session to authorize against, so they do need
    # sudo. Target the ssh ALIAS, not the IP: ~/.ssh/config maps the aliases to
    # the touchless key, while the raw IP falls through to `Host *` and fails
    # with "Permission denied (publickey)".
    target = config.get("ssh") or f"{config['user']}@{config['ip']}"
    if is_windows:
        return ["ssh", *SSH_OPTIONS, target, " ".join(remote)], "nssm"
    if action == "status":
        return ["ssh", *SSH_OPTIONS, target, " ".join(remote)], "systemd"
    return ["ssh", *SSH_OPTIONS, target, "sudo " + " ".join(remote)], "systemd"


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("action", choices=ACTIONS)
    parser.add_argument("host")
    parser.add_argument("unit")
    args = parser.parse_args()

    config = FLEET.get(args.host)
    if not config:
        fail(f"Unknown host: {args.host}")

    is_windows = config.get("platform") == "windows"
    if is_windows:
        unit = args.unit  # NSSM service names have no .service suffix
    else:
        unit = args.unit if args.unit.endswith(".service") else f"{args.unit}.service"

    config, miner = find_miner(args.host, unit)
    command, mode = build_command(args.host, unit, args.action, miner)

    env = dict(os.environ)
    if mode == "k8s":
        env["KUBECONFIG"] = env.get("KUBECONFIG") or KUBECONFIG

    try:
        if mode == "k8s":
            completed = run_k8s(command, env)
        else:
            completed = subprocess.run(
                command,
                capture_output=True,
                text=True,
                timeout=30,
                check=False,
                env=env,
            )
    except subprocess.TimeoutExpired:
        fail(f"Timed out running {args.action} on {args.host}")
    except FileNotFoundError as error:
        fail(str(error))

    output = (completed.stdout or "").strip()
    error = (completed.stderr or "").strip()

    # `is-active` exits non-zero for a stopped unit, which is an answer rather
    # than a failure. Every other action treats a non-zero exit as an error.
    ok = completed.returncode == 0 or args.action == "status"

    state = output
    if mode == "k8s" and args.action == "status":
        # Map the replica count to the systemctl-style vocabulary the panel
        # expects: readyReplicas >= 1 -> "active", "" (scaled to 0) -> "inactive".
        # A kubectl failure (endpoint unreachable, RBAC) is "unknown", never
        # "inactive" — a dead API must not read as a deliberate pause.
        if completed.returncode != 0:
            state = "unknown"
        else:
            state = "active" if output and output != "0" else "inactive"

    print(json.dumps({
        "ok": ok,
        "action": args.action,
        "host": args.host,
        "unit": unit,
        "mode": mode,
        "state": state,
        "error": "" if ok else (error or f"exit {completed.returncode}"),
    }))
    sys.exit(0 if ok else completed.returncode)


if __name__ == "__main__":
    main()
