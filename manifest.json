{
  "schemaVersion": 1,
  "id": "io.github.jkro.miners",
  "name": "Miners",
  "version": "2.1.0",
  "author": "j_kro",
  "license": "MIT",
  "description": "Fleet-wide GPU miner monitoring in the Omarchy bar: total hashrate plus a panel with per-GPU hashrate, power, temperature, pause/resume, and estimated PRL earnings from the live pool rate and PRL price.",
  "homepage": "https://github.com/reverb256/omarchy-miners",
  "repository": "https://github.com/reverb256/omarchy-miners",
  "keywords": ["mining", "gpu", "hashrate", "peakminer", "fleet", "nvidia", "pearl", "prl", "earnings"],
  "kinds": ["bar-widget"],
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Miners",
    "description": "Total hashrate, power, active GPU count, and estimated earnings across the mining fleet.",
    "category": "System",
    "aliases": ["miners", "mining"],
    "allowMultiple": false,
    "defaultSection": "left",
    "defaults": {
      "refreshIntervalSec": 10,
      "barDisplay": "Hashrate",
      "tempWarnC": 70,
      "tempAlarmC": 80,
      "revenueCurrency": "USD",
      "revenueIntervalSec": 600
    },
    "schema": [
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Refresh interval (seconds)",
        "description": "How often every miner's /summary endpoint is polled.",
        "min": 5,
        "max": 300,
        "step": 5,
        "defaultValue": 10
      },
      {
        "key": "barDisplay",
        "type": "enum",
        "label": "What to show on the bar",
        "options": ["Hashrate", "Hashrate and power", "Earnings ($/day)", "Icon only"],
        "defaultValue": "Hashrate"
      },
      {
        "key": "tempWarnC",
        "type": "integer",
        "label": "Warn above (°C)",
        "min": 40,
        "max": 100,
        "step": 1,
        "defaultValue": 70
      },
      {
        "key": "tempAlarmC",
        "type": "integer",
        "label": "Alarm above (°C)",
        "min": 40,
        "max": 110,
        "step": 1,
        "defaultValue": 80
      },
      {
        "key": "revenueCurrency",
        "type": "enum",
        "label": "Earnings currency",
        "description": "Fiat currency for the earnings estimate, converted from the pool's live rates feed.",
        "options": ["USD", "CAD", "EUR", "GBP"],
        "defaultValue": "USD"
      },
      {
        "key": "revenueIntervalSec",
        "type": "integer",
        "label": "Earnings refresh (seconds)",
        "description": "How often the PRL price and the pool's coins-per-day rate are re-fetched.",
        "min": 60,
        "max": 3600,
        "step": 60,
        "defaultValue": 600
      }
    ]
  }
}
